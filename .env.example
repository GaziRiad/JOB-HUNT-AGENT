# Local development only. In GitHub Actions these are set as repository secrets
# (Settings -> Secrets and variables -> Actions), not committed here.

# Anthropic API key (Phase 3 onward). Cost is a few cents/day at this volume.
ANTHROPIC_API_KEY=

# The target Google Sheet's ID (the long string in its URL between /d/ and /edit).
SHEET_ID=

# The service-account key. Paste the JSON on a single line, OR base64-encode the
# whole file and paste that. The Sheet must be shared with the service account's
# client_email (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=
